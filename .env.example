# ---------------------------------------------------------------------------
# DESENVOLVIMENTO — copie para .env.local
# Somente variáveis com o prefixo VITE_ chegam ao bundle do browser.
# ---------------------------------------------------------------------------

VITE_APP_NAME=empregol
VITE_API_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SERVIDOR (deploy) — no servidor este arquivo vira .env, lido pelo compose.
#
# VITE_API_URL é consumida em TEMPO DE BUILD (Vite injeta no bundle), então
# mudar esse valor exige rebuild da imagem, não só restart do container.
#
#   VITE_API_URL=https://api.empregolstartup.com.br
#   WEB_DOMAIN=empregolstartup.com.br
#   WEB_DOMAIN_WWW=www.empregolstartup.com.br
# ---------------------------------------------------------------------------
